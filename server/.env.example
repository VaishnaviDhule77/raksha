# ── RAKSHA backend configuration ─────────────────────────────
# Copy this file to .env and adjust. NEVER commit .env (it is git-ignored).

# Port for the API (and the client/ frontend, if present)
PORT=4000

# development | production
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────
# Local MongoDB (default install — database "raksha" is created automatically):
MONGODB_URI=mongodb+srv://raksha:FB7m2s0Xvli3xMld@cluster0.kitgdoe.mongodb.net/?appName=Cluster0

# MongoDB Atlas example — replace USER, PASSWORD and the cluster host:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.abcde.mongodb.net/raksha?retryWrites=true&w=majority